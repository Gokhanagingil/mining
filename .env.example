# Mining Platform - Environment Variables
# Copy to .env and configure before running

# ─── Database ───────────────────────────────
DATABASE_URL=postgresql://mining:mining@postgres:5432/mining

# ─── Storage ────────────────────────────────
STORAGE_PATH=/data/storage
PARQUET_PATH=/data/parquet
MAX_FILE_SIZE_MB=500

# ─── Worker ─────────────────────────────────
WORKER_URL=http://worker:8000

# ─── LLM (optional) ─────────────────────────
# If not set, system uses built-in evidence-based mock commentary
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Set to true to force mock even if API key is present
USE_MOCK_LLM=false

# ─── Frontend ───────────────────────────────
# URL of the API as seen from the browser
VITE_API_URL=http://localhost:3001

# ─── CORS ───────────────────────────────────
CORS_ORIGIN=*
